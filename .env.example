# GoDex secret / deployment overrides
#
# Non-sensitive defaults now live in godex.yaml.
# Environment variables override godex.yaml with this precedence:
# godex.yaml < .env < process env

# Anthropic-compatible API key
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Optional Web/API shared bearer token
GODEX_WEB_TOKEN=

# Optional built-in web tool provider keys
GODEX_WEB_SEARCH_BRAVE_API_KEY=
GODEX_WEB_SEARCH_EXA_API_KEY=
GODEX_WEB_SEARCH_TAVILY_API_KEY=

# Optional Feishu/Lark credentials
FEISHU_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_DOMAIN=lark

# Optional deployment overrides
LOG_LEVEL=
LOG_FILE=
LOG_MIRROR_TO_STDERR=
GODEX_WEB_SEARCH_ENABLED=
GODEX_WEB_SEARCH_PROVIDER_ORDER=
GODEX_WEB_SEARCH_CACHE_TTL_SECONDS=
GODEX_WEB_FETCH_ENABLED=
GODEX_WEB_FETCH_MAX_CHARS=
GODEX_WEB_FETCH_TIMEOUT_SECONDS=
GODEX_WEB_FETCH_POLICY=
GODEX_WEB_FETCH_ALLOWED_DOMAINS=
GODEX_WEB_FETCH_BLOCKED_DOMAINS=
GODEX_WEB_FETCH_ALLOW_PRIVATE_HOSTS=
GODEX_GLOB_DEFAULT_MAX_RESULTS=
GODEX_BROWSER_ENABLED=
GODEX_BROWSER_HEADLESS=
GODEX_BROWSER_CDP_URL=
GODEX_BROWSER_ACTION_TIMEOUT_SECONDS=
GODEX_BROWSER_IDLE_TIMEOUT_SECONDS=
GODEX_BROWSER_MAX_PAGES_PER_SESSION=
GODEX_BROWSER_ALLOW_PRIVATE_HOSTS=

# Optional process-level config file override
GODEX_CONFIG=
