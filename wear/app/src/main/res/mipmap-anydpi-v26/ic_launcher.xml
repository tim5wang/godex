<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive launcher icon (API 26+, and minSdk is 30, so this is the path every
  target watch actually uses).

  The background is the white canvas the mark sits on in the source artwork, and
  the foreground is the mark itself scaled into the 66/108 safe zone. Keeping the
  two as separate layers is what lets the system apply its own mask: a round
  watch gets a round crop, and the badge is already round, so nothing of the
  artwork is lost to the mask.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
