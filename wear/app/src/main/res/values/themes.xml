<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Round-screen watch theme. Dark by default: OLED watch displays save power
      on black, which matters for a device whose job is to sit on a wrist all day.
    -->
    <style name="Theme.GodexWear" parent="android:Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
